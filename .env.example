# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Client URL (for CORS in production, e.g. https://your-japan-auction.vercel.app)
CLIENT_URL=*

# Database Connection (Optional if deploying with MongoDB or PostgreSQL)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/japan_auction
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/japan_auction
